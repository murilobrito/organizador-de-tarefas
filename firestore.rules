rules_version = '2';

// Regras de segurança do Firestore — cole no Console do Firebase
// (Firestore Database > Regras) e clique em "Publicar".
// Visitantes: leem apenas o que estiver marcado como público.
// Escrita: somente o e-mail do administrador.

service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email == 'murilo.brito@chebabi.com';
    }

    match /projetos/{id} {
      allow read: if ehAdmin() || resource.data.publico == true;
      allow write: if ehAdmin();
    }

    match /sprints/{id} {
      allow read: if ehAdmin() || resource.data.publico == true;
      allow write: if ehAdmin();
    }

    // Qualquer outra coleção fica bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
