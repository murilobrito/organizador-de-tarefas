# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK)
# Se estas variáveis ficarem vazias, o site roda em MODO DEMONSTRAÇÃO (dados só no navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail do administrador (o único que pode criar/editar demandas)
VITE_ADMIN_EMAIL=murilo.brito@chebabi.com
